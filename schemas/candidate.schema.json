{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variaxiom.dev/schemas/candidate.schema.json",
  "title": "Variaxiom inheritable-change candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "parent_id",
    "artifact_hash",
    "proposer",
    "rollback_target",
    "baseline_capabilities",
    "requested_capabilities",
    "estimated_cost_micro_usd"
  ],
  "properties": {
    "candidate_id": { "$ref": "#/$defs/token" },
    "parent_id": { "$ref": "#/$defs/token" },
    "artifact_hash": { "$ref": "#/$defs/sha256" },
    "proposer": { "$ref": "#/$defs/token" },
    "rollback_target": { "$ref": "#/$defs/token" },
    "baseline_capabilities": {
      "description": "Candidate declaration checked against trusted context; never an authority source.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "requested_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "estimated_cost_micro_usd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/canonicalValue" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "token": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "[\\u0000-\\u001f\\u007f]" }
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "[,\\u0000-\\u001f\\u007f]" }
    },
    "canonicalValue": {
      "oneOf": [
        { "type": ["string", "boolean", "null"] },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        { "type": "array", "items": { "$ref": "#/$defs/canonicalValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/canonicalValue" }
        }
      ]
    }
  }
}
