{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variaxiom.dev/schemas/evidence.schema.json",
  "title": "Variaxiom evaluation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "subject_id",
    "artifact_hash",
    "check",
    "status",
    "verifier",
    "independent"
  ],
  "properties": {
    "evidence_id": { "$ref": "#/$defs/token" },
    "subject_id": { "$ref": "#/$defs/token" },
    "artifact_hash": { "$ref": "#/$defs/sha256" },
    "check": { "$ref": "#/$defs/token" },
    "status": { "enum": ["pass", "fail", "error"] },
    "verifier": { "$ref": "#/$defs/token" },
    "independent": { "type": "boolean" },
    "details": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/canonicalValue" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "token": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "[\\u0000-\\u001f\\u007f]" }
    },
    "canonicalValue": {
      "oneOf": [
        { "type": ["string", "boolean", "null"] },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        { "type": "array", "items": { "$ref": "#/$defs/canonicalValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/canonicalValue" }
        }
      ]
    }
  }
}
