{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variaxiom.dev/schemas/experiment.schema.json",
  "title": "Variaxiom evolutionary experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "hypothesis",
    "candidate_ids",
    "baselines",
    "metrics",
    "hard_constraints",
    "budget",
    "holdout_policy",
    "termination"
  ],
  "properties": {
    "experiment_id": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "candidate_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "baselines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "metrics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "hard_constraints": { "type": "array", "items": { "type": "string" } },
    "budget": {
      "type": "object",
      "required": ["max_cost_usd", "max_wall_seconds", "max_attempts"],
      "properties": {
        "max_cost_usd": { "type": "number", "minimum": 0 },
        "max_wall_seconds": { "type": "integer", "minimum": 1 },
        "max_attempts": { "type": "integer", "minimum": 1 }
      }
    },
    "holdout_policy": { "type": "string", "minLength": 1 },
    "termination": { "type": "string", "minLength": 1 }
  }
}
