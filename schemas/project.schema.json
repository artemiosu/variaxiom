{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variaxiom.dev/schemas/project.schema.json",
  "title": "Variaxiom project context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "reviewed",
    "repository",
    "release",
    "source_of_truth",
    "active_increment",
    "next_increment",
    "requirements",
    "milestones",
    "evidence",
    "open_decisions",
    "risks",
    "blockers",
    "deferred",
    "context_packs",
    "required_checks",
    "external_state"
  ],
  "properties": {
    "schema_version": { "const": "variaxiom-project/v1" },
    "project": { "const": "Variaxiom" },
    "reviewed": { "type": "string", "format": "date" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "default_branch", "visibility"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "default_branch": { "type": "string", "minLength": 1 },
        "visibility": { "enum": ["public", "private"] }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_version", "python_version", "rust_version", "state", "tag"],
      "properties": {
        "display_version": { "type": "string", "minLength": 1 },
        "python_version": { "type": "string", "minLength": 1 },
        "rust_version": { "type": "string", "minLength": 1 },
        "state": { "enum": ["unreleased", "released", "retired"] },
        "tag": { "type": ["string", "null"] }
      }
    },
    "source_of_truth": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/path" }
    },
    "active_increment": { "$ref": "#/$defs/increment" },
    "next_increment": { "$ref": "#/$defs/increment" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[A-Z]+-[0-9]{3}$" },
          "status": { "$ref": "#/$defs/status" },
          "evidence": { "$ref": "#/$defs/path_array" }
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "document"],
        "properties": {
          "id": { "type": "string", "pattern": "^M[0-9]+$" },
          "status": { "$ref": "#/$defs/status" },
          "document": { "$ref": "#/$defs/path" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "observed_on", "check", "result", "artifact"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "observed_on": { "type": "string", "format": "date" },
          "check": { "type": "string", "minLength": 1 },
          "result": { "enum": ["passed", "failed"] },
          "artifact": { "$ref": "#/$defs/path" }
        }
      }
    },
    "open_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "target", "question"],
        "properties": {
          "id": { "type": "string", "pattern": "^DEC-[0-9]{3}$" },
          "status": { "$ref": "#/$defs/status" },
          "target": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "document"],
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]+$" },
          "status": { "enum": ["active", "mitigating", "accepted", "closed"] },
          "document": { "$ref": "#/$defs/path" }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "scope"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["open", "manual", "resolved"] },
          "scope": { "type": "string", "minLength": 1 }
        }
      }
    },
    "deferred": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "context_packs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/path_array" }
    },
    "required_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local", "github"],
      "properties": {
        "local": { "$ref": "#/$defs/string_array" },
        "github": { "$ref": "#/$defs/string_array" }
      }
    },
    "external_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_on", "repository", "pages", "discussions", "authenticated_settings"],
      "properties": {
        "observed_on": { "type": "string", "format": "date" },
        "repository": { "enum": ["confirmed", "unknown"] },
        "pages": { "enum": ["confirmed", "unknown"] },
        "discussions": { "enum": ["confirmed", "unknown"] },
        "authenticated_settings": { "enum": ["confirmed", "recheck_required"] }
      }
    }
  },
  "$defs": {
    "status": {
      "enum": ["planned", "accepted", "in_progress", "implemented", "verified", "partial", "blocked", "deferred", "retired"]
    },
    "path": { "type": "string", "minLength": 1 },
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "path_array": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "increment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "specification"],
      "properties": {
        "id": { "type": "string", "pattern": "^M[0-9]+\\.[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "verification": { "type": "string", "minLength": 1 },
        "specification": {
          "oneOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }]
        },
        "requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^REQ-[A-Z]+-[0-9]{3}$" }
        }
      }
    }
  }
}
