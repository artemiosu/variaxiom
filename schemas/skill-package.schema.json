{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variaxiom.dev/schemas/skill-package.schema.json",
  "title": "Variaxiom proof-carrying skill package",
  "description": "A skill is a versioned hypothesis until evidence promotes it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "purpose",
    "state",
    "preconditions",
    "procedure",
    "required_capabilities",
    "tests",
    "provenance",
    "scope",
    "known_failures",
    "expires_at"
  ],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "version": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "state": {
      "enum": [
        "observation",
        "hypothesis",
        "experimental",
        "verified",
        "production",
        "degraded",
        "deprecated",
        "retired"
      ]
    },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "procedure": { "type": "string", "minLength": 1 },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "created_at", "creator"],
      "properties": {
        "source": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "creator": { "type": "string" },
        "parent_hash": { "type": ["string", "null"] }
      }
    },
    "scope": {
      "type": "object",
      "required": ["environments", "models"],
      "properties": {
        "environments": { "type": "array", "items": { "type": "string" } },
        "models": { "type": "array", "items": { "type": "string" } }
      }
    },
    "known_failures": { "type": "array", "items": { "type": "string" } },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "evidence_hashes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }
  }
}
