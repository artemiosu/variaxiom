{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variaxiom.dev/schemas/tool-manifest.schema.json",
  "title": "Variaxiom generated-tool manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "artifact_hash",
    "interface",
    "effects",
    "limits",
    "build",
    "tests",
    "rollback"
  ],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "version": { "type": "string", "minLength": 1 },
    "artifact_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "interface": {
      "type": "object",
      "required": ["wit_world"],
      "properties": {
        "wit_world": { "type": "string", "minLength": 1 },
        "input_schema": { "type": ["string", "null"] },
        "output_schema": { "type": ["string", "null"] }
      }
    },
    "effects": {
      "type": "object",
      "required": ["filesystem", "network", "processes", "secrets"],
      "properties": {
        "filesystem": { "type": "array", "items": { "type": "string" } },
        "network": { "type": "array", "items": { "type": "string" } },
        "processes": { "type": "array", "items": { "type": "string" } },
        "secrets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "limits": {
      "type": "object",
      "required": ["cpu_ms", "memory_mb", "wall_ms", "output_bytes"],
      "properties": {
        "cpu_ms": { "type": "integer", "minimum": 1 },
        "memory_mb": { "type": "integer", "minimum": 1 },
        "wall_ms": { "type": "integer", "minimum": 1 },
        "output_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "build": {
      "type": "object",
      "required": ["source_hash", "builder", "reproducible"],
      "properties": {
        "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "builder": { "type": "string" },
        "reproducible": { "type": "boolean" },
        "provenance": { "type": ["string", "null"] }
      }
    },
    "tests": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "rollback": {
      "type": "object",
      "required": ["previous_version", "reversible"],
      "properties": {
        "previous_version": { "type": ["string", "null"] },
        "reversible": { "type": "boolean" }
      }
    }
  }
}
