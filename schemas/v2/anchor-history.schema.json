{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variaxiom.dev/schemas/v2/anchor-history.schema.json",
  "title": "Variaxiom bounded trusted-anchor transition history",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "initial_anchor", "initial_identity_context", "initial_authorization_context", "steps"
  ],
  "properties": {
    "initial_anchor": {"$ref": "trusted-anchor.schema.json"},
    "initial_identity_context": {"$ref": "envelope.schema.json#/$defs/identityContext"},
    "initial_authorization_context": {"$ref": "envelope.schema.json#/$defs/authorizationContext"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/anchorStep"}
    },
    "probe_attested_proposal": {"$ref": "common.schema.json#/$defs/canonicalValue"}
  },
  "$defs": {
    "anchorStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_identity_context", "next_authorization_context", "trusted_now_unix_s"],
      "properties": {
        "next_identity_context": {"$ref": "envelope.schema.json#/$defs/identityContext"},
        "next_authorization_context": {"$ref": "envelope.schema.json#/$defs/authorizationContext"},
        "trusted_now_unix_s": {"$ref": "common.schema.json#/$defs/safeUint"}
      }
    }
  }
}
