{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variaxiom.dev/schemas/v2/attested-proposal.schema.json",
  "title": "Variaxiom attested-proposal/v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_version", "promotion_input", "decision", "selector_signature"],
  "properties": {
    "proposal_version": {"const": "attested-proposal/v1"},
    "promotion_input": {
      "type": "object", "additionalProperties": false,
      "required": ["envelope_version", "kind", "payload"],
      "properties": {
        "envelope_version": {"const": "variaxiom-envelope/v1"},
        "kind": {"const": "promotion-input"},
        "payload": {"$ref": "promotion-input.schema.json"}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["envelope_version", "kind", "payload"],
      "properties": {
        "envelope_version": {"const": "variaxiom-envelope/v1"},
        "kind": {"const": "promotion-decision"},
        "payload": {"$ref": "../promotion.schema.json"}
      }
    },
    "selector_signature": {
      "type": "object", "additionalProperties": false,
      "required": ["envelope_version", "kind", "payload"],
      "properties": {
        "envelope_version": {"const": "variaxiom-envelope/v1"},
        "kind": {"const": "detached-signature"},
        "payload": {"$ref": "detached-signature.schema.json"}
      }
    }
  }
}
