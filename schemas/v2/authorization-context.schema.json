{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variaxiom.dev/schemas/v2/authorization-context.schema.json",
  "title": "Variaxiom authorization-context/v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_context_version", "trust_domain_id", "capability_namespace", "lineage_id",
    "constitution_envelope_digest", "constitution_artifact_hash", "known_lineage_ids",
    "lineage_capabilities", "verified_artifact_hashes"
  ],
  "properties": {
    "authorization_context_version": {"const": "authorization-context/v1"},
    "trust_domain_id": {"$ref": "common.schema.json#/$defs/trustDomainId"},
    "capability_namespace": {"const": "variaxiom-capability/v1"},
    "lineage_id": {"$ref": "common.schema.json#/$defs/token"},
    "constitution_envelope_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "constitution_artifact_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "known_lineage_ids": {
      "type": "array", "maxItems": 4096, "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/token"}
    },
    "lineage_capabilities": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": {
        "type": "array", "maxItems": 128, "uniqueItems": true,
        "items": {"$ref": "common.schema.json#/$defs/capability"}
      }
    },
    "verified_artifact_hashes": {
      "type": "array", "maxItems": 4096, "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/sha256"}
    }
  }
}
