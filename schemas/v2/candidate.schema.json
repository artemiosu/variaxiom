{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variaxiom.dev/schemas/v2/candidate.schema.json",
  "title": "Variaxiom candidate/v2 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_version", "candidate_id", "parent_id", "artifact_hash", "proposer",
    "rollback_target", "baseline_capabilities", "requested_capabilities",
    "estimated_cost_micro_usd", "metadata"
  ],
  "properties": {
    "candidate_version": {"const": "candidate/v2"},
    "candidate_id": {"$ref": "common.schema.json#/$defs/token"},
    "parent_id": {"$ref": "common.schema.json#/$defs/token"},
    "artifact_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "proposer": {"$ref": "common.schema.json#/$defs/principalId"},
    "rollback_target": {"$ref": "common.schema.json#/$defs/token"},
    "baseline_capabilities": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/capability"}
    },
    "requested_capabilities": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/capability"}
    },
    "estimated_cost_micro_usd": {"$ref": "common.schema.json#/$defs/safeUint"},
    "metadata": {
      "type": "object",
      "additionalProperties": {"$ref": "common.schema.json#/$defs/canonicalValue"}
    }
  }
}
