{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variaxiom.dev/schemas/v2/common.schema.json",
  "title": "Variaxiom M2.1 common definitions",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "safeUint": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positiveSafeInt": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "token": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "[,\\u0000-\\u001f\\u007f]"}
    },
    "principalId": {
      "type": "string",
      "pattern": "^principal:[a-z0-9._:/-]+$"
    },
    "trustDomainId": {
      "type": "string",
      "pattern": "^trust-domain:[a-z0-9._:/-]+$"
    },
    "keyId": {"type": "string", "pattern": "^key:sha256:[a-f0-9]{64}$"},
    "grantId": {"type": "string", "pattern": "^grant:sha256:[a-f0-9]{64}$"},
    "capability": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9._:/-]+$"
    },
    "publicKeyBase64url": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
    },
    "signatureBase64url": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
    },
    "stableVerificationCode": {
      "enum": [
        "input.encoding_invalid", "input.duplicate_member", "input.schema_invalid",
        "input.version_unsupported", "input.kind_mismatch", "input.limit_exceeded",
        "signature.algorithm_unsupported", "signature.encoding_invalid",
        "signature.key_id_mismatch", "signature.key_revoked", "signature.domain_mismatch",
        "signature.principal_mismatch", "signature.kind_mismatch",
        "signature.digest_mismatch", "signature.invalid", "identity.principal_unknown",
        "identity.context_untrusted", "identity.context_stale", "identity.key_ambiguous",
        "identity.key_unbound", "identity.role_missing", "identity.role_conflict",
        "identity.not_independent", "authorization.context_untrusted",
        "evidence.subject_digest_mismatch", "grant.audience_mismatch",
        "grant.context_mismatch", "grant.subject_mismatch", "grant.capability_mismatch",
        "grant.interval_invalid", "grant.not_yet_valid", "grant.expired", "grant.revoked",
        "grant.delegation_forbidden", "constitution.context_mismatch",
        "constitution.artifact_mismatch", "decision.content_mismatch",
        "lineage.head_mismatch"
      ]
    },
    "canonicalValue": {
      "oneOf": [
        {"type": ["string", "boolean", "null"]},
        {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        {"type": "array", "items": {"$ref": "#/$defs/canonicalValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/canonicalValue"}}
      ]
    }
  }
}
