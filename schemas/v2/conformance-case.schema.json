{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variaxiom.dev/schemas/v2/conformance-case.schema.json",
  "title": "Variaxiom M2.1 self-contained conformance case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_version", "case_id", "entrypoint", "stage", "expected",
    "input_base64url", "input_sha256", "signature_vectors"
  ],
  "properties": {
    "case_version": {"const": "m2.1-conformance-case/v1"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "entrypoint": {
      "enum": ["verify-attested-proposal", "initialize-anchor", "advance-anchor-history", "replay-historical"]
    },
    "stage": {"type": "integer", "minimum": 1, "maximum": 11},
    "input_base64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "input_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "trusted_anchor": {"$ref": "trusted-anchor.schema.json"},
    "anchor_history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_anchor", "initial_identity_context", "initial_authorization_context", "steps"
      ],
      "properties": {
        "initial_anchor": {"$ref": "trusted-anchor.schema.json"},
        "initial_identity_context": {"$ref": "envelope.schema.json#/$defs/identityContext"},
        "initial_authorization_context": {"$ref": "envelope.schema.json#/$defs/authorizationContext"},
        "steps": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {"$ref": "#/$defs/anchorStep"}
        },
        "probe_attested_proposal": {"$ref": "envelope.schema.json#/$defs/attestedProposal"}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "code", "decision_status", "authorizing"],
      "properties": {
        "status": {"enum": ["verified", "rejected"]},
        "code": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/stableCode"}]},
        "decision_status": {"enum": ["accepted", "rejected", "not-reached"]},
        "authorizing": {"type": "boolean"}
      }
    },
    "signature_vectors": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "signature-vector.schema.json"}
    },
    "notes": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"entrypoint": {"enum": ["verify-attested-proposal", "replay-historical"]}}},
      "then": {"required": ["trusted_anchor"]}
    },
    {
      "if": {"properties": {"entrypoint": {"const": "advance-anchor-history"}}},
      "then": {"required": ["anchor_history"]}
    },
    {
      "if": {"properties": {"expected": {"properties": {"status": {"const": "verified"}}}}},
      "then": {"properties": {"expected": {"properties": {"code": {"type": "null"}}}}}
    },
    {
      "if": {"properties": {"expected": {"properties": {"status": {"const": "rejected"}}}}},
      "then": {"properties": {"expected": {"properties": {"code": {"type": "string"}}}}}
    }
  ],
  "$defs": {
    "anchorStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_identity_context", "next_authorization_context", "trusted_now_unix_s"],
      "properties": {
        "next_identity_context": {"$ref": "envelope.schema.json#/$defs/identityContext"},
        "next_authorization_context": {"$ref": "envelope.schema.json#/$defs/authorizationContext"},
        "trusted_now_unix_s": {"$ref": "common.schema.json#/$defs/safeUint"}
      }
    },
    "stableCode": {
      "enum": [
        "input.encoding_invalid", "input.duplicate_member", "input.schema_invalid",
        "input.version_unsupported", "input.kind_mismatch", "input.limit_exceeded",
        "signature.algorithm_unsupported", "signature.encoding_invalid",
        "signature.key_id_mismatch", "signature.key_revoked", "signature.domain_mismatch",
        "signature.principal_mismatch", "signature.kind_mismatch",
        "signature.digest_mismatch", "signature.invalid", "identity.principal_unknown",
        "identity.context_untrusted", "identity.context_stale", "identity.key_ambiguous",
        "identity.key_unbound", "identity.role_missing", "identity.role_conflict",
        "identity.not_independent", "authorization.context_untrusted",
        "evidence.subject_digest_mismatch", "grant.audience_mismatch",
        "grant.context_mismatch", "grant.subject_mismatch", "grant.capability_mismatch",
        "grant.interval_invalid", "grant.not_yet_valid", "grant.expired", "grant.revoked",
        "grant.delegation_forbidden", "constitution.context_mismatch",
        "constitution.artifact_mismatch", "decision.content_mismatch",
        "lineage.head_mismatch"
      ]
    }
  }
}
