{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variaxiom.dev/schemas/v2/conformance-case.schema.json",
  "title": "Variaxiom M2.1 self-contained conformance case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_version", "case_id", "entrypoint", "stage", "expected",
    "input_base64url", "input_sha256", "signature_vectors"
  ],
  "properties": {
    "case_version": {"const": "m2.1-conformance-case/v1"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "entrypoint": {
      "enum": ["evaluate-new", "verify-attested-proposal", "initialize-anchor", "advance-anchor-history", "replay-historical"]
    },
    "stage": {"type": "integer", "minimum": 1, "maximum": 11},
    "input_base64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "input_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "trusted_anchor": {"$ref": "trusted-anchor.schema.json"},
    "anchor_history": {"$ref": "common.schema.json#/$defs/canonicalValue"},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "code", "decision_status", "authorizing", "reached_stage", "expected_anchor"],
      "properties": {
        "status": {"enum": ["verified", "rejected"]},
        "code": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/stableVerificationCode"}]},
        "decision_status": {"enum": ["accepted", "rejected", "not-reached"]},
        "authorizing": {"const": false},
        "reached_stage": {"type": "integer", "minimum": 1, "maximum": 11},
        "expected_anchor": {
          "oneOf": [{"type": "null"}, {"$ref": "trusted-anchor.schema.json"}]
        }
      }
    },
    "signature_vectors": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "signature-vector.schema.json"}
    },
    "notes": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"entrypoint": {"enum": ["evaluate-new", "verify-attested-proposal", "replay-historical"]}}},
      "then": {"required": ["trusted_anchor"], "not": {"required": ["anchor_history"]}}
    },
    {
      "if": {"properties": {"entrypoint": {"const": "advance-anchor-history"}}},
      "then": {"required": ["anchor_history"], "not": {"required": ["trusted_anchor"]}}
    },
    {
      "if": {"properties": {"entrypoint": {"const": "initialize-anchor"}}},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["trusted_anchor"]},
            {"required": ["anchor_history"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"expected": {"properties": {"status": {"const": "verified"}}}}},
      "then": {"properties": {"expected": {"properties": {"code": {"type": "null"}}}}}
    },
    {
      "if": {"properties": {"expected": {"properties": {"status": {"const": "rejected"}}}}},
      "then": {
        "properties": {
          "expected": {
            "properties": {"code": {"type": "string"}, "authorizing": {"const": false}}
          }
        }
      }
    },
    {
      "if": {"properties": {"entrypoint": {"enum": ["initialize-anchor", "advance-anchor-history", "replay-historical"]}}},
      "then": {"properties": {"expected": {"properties": {"authorizing": {"const": false}}}}}
    },
    {
      "if": {
        "properties": {
          "entrypoint": {"enum": ["initialize-anchor", "advance-anchor-history"]},
          "expected": {"properties": {"status": {"const": "verified"}}}
        }
      },
      "then": {"properties": {"expected": {"properties": {"expected_anchor": {"$ref": "trusted-anchor.schema.json"}}}}},
      "else": {"properties": {"expected": {"properties": {"expected_anchor": {"type": "null"}}}}}
    }
  ]
}
