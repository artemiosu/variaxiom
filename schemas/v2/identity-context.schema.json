{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variaxiom.dev/schemas/v2/identity-context.schema.json",
  "title": "Variaxiom identity-context/v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity_context_version", "trust_domain_id", "snapshot_sequence",
    "previous_snapshot_digest", "evaluation_time_unix_s", "principals",
    "revoked_key_ids", "revoked_grant_ids"
  ],
  "properties": {
    "identity_context_version": {"const": "identity-context/v1"},
    "trust_domain_id": {"$ref": "common.schema.json#/$defs/trustDomainId"},
    "snapshot_sequence": {"$ref": "common.schema.json#/$defs/safeUint"},
    "previous_snapshot_digest": {
      "oneOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]
    },
    "evaluation_time_unix_s": {"$ref": "common.schema.json#/$defs/safeUint"},
    "principals": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "principal.schema.json"}
    },
    "revoked_key_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/keyId"}
    },
    "revoked_grant_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/grantId"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"snapshot_sequence": {"const": 0}}, "required": ["snapshot_sequence"]},
      "then": {"properties": {"previous_snapshot_digest": {"type": "null"}}},
      "else": {"properties": {"previous_snapshot_digest": {"$ref": "common.schema.json#/$defs/sha256"}}}
    }
  ]
}
