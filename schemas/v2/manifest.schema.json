{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variaxiom.dev/schemas/v2/manifest.schema.json",
  "title": "Variaxiom M2.1 shared conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "spec_revision", "base_fixture", "cases"],
  "properties": {
    "manifest_version": {"const": "m2.1-conformance-manifest/v2"},
    "spec_revision": {"$ref": "common.schema.json#/$defs/sha256"},
    "base_fixture": {"type": "string", "const": "base-attested-proposal.json"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "fixture", "stage"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "fixture": {"type": "string", "pattern": "^cases/[a-z0-9][a-z0-9-]+\\.json$"},
          "stage": {"type": "integer", "minimum": 1, "maximum": 11}
        }
      }
    }
  }
}
