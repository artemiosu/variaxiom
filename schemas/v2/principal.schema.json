{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variaxiom.dev/schemas/v2/principal.schema.json",
  "title": "Variaxiom principal/v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["principal_version", "principal_id", "roles", "keys"],
  "properties": {
    "principal_version": {"const": "principal/v1"},
    "principal_id": {"$ref": "common.schema.json#/$defs/principalId"},
    "roles": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/token"}
    },
    "keys": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/keyBinding"}
    }
  },
  "$defs": {
    "keyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_binding_version", "algorithm", "key_id", "public_key_base64url"],
      "properties": {
        "key_binding_version": {"const": "key-binding/v1"},
        "algorithm": {"$ref": "common.schema.json#/$defs/token"},
        "key_id": {"$ref": "common.schema.json#/$defs/keyId"},
        "public_key_base64url": {"$ref": "common.schema.json#/$defs/publicKeyBase64url"}
      }
    }
  }
}
