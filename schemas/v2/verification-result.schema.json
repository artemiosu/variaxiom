{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variaxiom.dev/schemas/v2/verification-result.schema.json",
  "title": "Variaxiom M2.1 verification result",
  "type": "object",
  "additionalProperties": false,
  "required": ["verification_version", "status", "code"],
  "properties": {
    "verification_version": {"const": "verification-result/v1"},
    "status": {"enum": ["verified", "rejected"]},
    "code": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/stableVerificationCode"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "verified"}}},
      "then": {"properties": {"code": {"type": "null"}}},
      "else": {"properties": {"code": {"$ref": "common.schema.json#/$defs/stableVerificationCode"}}}
    }
  ]
}
